@model ScoreCircle.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "My Credit Health";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-semibold mb-0">Hey, @Model.UserName </h2>
            <p class="text-muted">Here's your credit health snapshot</p>
        </div>
        <div class="col-auto d-flex align-items-center gap-2">
            @if (Model.UserCircles.Any())
            {
                <a asp-controller="Circle" asp-action="Index" asp-route-id="@Model.UserCircles.First().Id"
                   class="btn btn-outline-primary btn-sm">
                    My Circle →
                </a>
            }
        </div>
    </div>

    <div class="row g-4">

        <!-- Score card -->
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center py-4">
                    <p class="text-muted small text-uppercase fw-semibold mb-2">Credit Score</p>
                    <div class="display-2 fw-bold text-@Model.TierColor">@Model.Score.Score</div>
                    <span class="badge bg-@Model.TierColor fs-6 mt-1">@Model.Score.Tier</span>

                    <div class="mt-3">
                        <div class="progress" style="height:10px">
                            <div class="progress-bar bg-@Model.TierColor"
                                 role="progressbar"
                                 style="width:@Model.TierPercent%"
                                 aria-valuenow="@Model.TierPercent" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-muted">300</small>
                            <small class="text-muted">850</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Score factors -->
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Score factors</h6>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Credit utilisation</span>
                            <span class="@(Model.Score.UtilisationPercent > 50 ? "text-danger fw-semibold" : "text-muted")">
                                @Model.Score.UtilisationPercent%
                            </span>
                        </div>
                        <div class="progress" style="height:6px">
                            <div class="progress-bar @(Model.Score.UtilisationPercent > 50 ? "bg-danger" : "bg-success")"
                                 style="width:@Model.Score.UtilisationPercent%"></div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Missed payments</span>
                        <span class="@(Model.Score.MissedPayments > 0 ? "text-danger fw-semibold" : "text-success")">
                            @Model.Score.MissedPayments
                        </span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Open accounts</span>
                        <span>@Model.Score.AccountsOpen</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 small">
                        <span class="text-muted">Credit age</span>
                        <span>@Model.Score.CreditAgeMonths months</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Circle summary / join -->
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Your circles</h6>

                    @if (Model.UserCircles.Any())
                    {
                        @foreach (var c in Model.UserCircles)
                        {
                            <a asp-controller="Circle" asp-action="Index" asp-route-id="@c.Id"
                               class="d-flex align-items-center gap-2 text-decoration-none text-dark mb-2 p-2 rounded hover-bg">
                                <span class="badge bg-primary rounded-circle p-2">◎</span>
                                <span class="small fw-semibold">@c.Name</span>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">You're not in a circle yet.</p>
                    }

                    <!-- Create circle -->
                    <form asp-controller="Circle" asp-action="Create" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <div class="input-group input-group-sm">
                            <input type="text" name="Name" class="form-control" placeholder="Circle name" required />
                            <button class="btn btn-primary" type="submit">Create</button>
                        </div>
                    </form>

                    <!-- Join circle -->
                    <form asp-controller="Circle" asp-action="Join" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <div class="input-group input-group-sm">
                            <input type="text" name="InviteCode" class="form-control text-uppercase"
                                   placeholder="Invite code" maxlength="8" style="letter-spacing:.1em" required />
                            <button class="btn btn-outline-secondary" type="submit">Join</button>
                        </div>
                    </form>

                    @if (TempData["Error"] != null)
                    {
                        <p class="text-danger small mt-2">@TempData["Error"]</p>
                    }
                </div>
            </div>
        </div>

    </div><!-- /row -->
    <!-- Advice section -->
    @if (Model.Advices.Any())
    {
        <div class="row mt-4">
            <div class="col">
                <h5 class="fw-semibold mb-3">Your personalised advice</h5>
                <div class="row g-3">
                    @foreach (var a in Model.Advices.OrderBy(x => x.Priority == "High" ? 0 : x.Priority == "Medium" ? 1 : 2))
                    {
                        var borderColor = a.Priority == "High" ? "danger" : a.Priority == "Medium" ? "warning" : "success";
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-start border-@borderColor border-3 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="card-title mb-0 fw-semibold">@a.Title</h6>
                                        <span class="badge bg-@borderColor ms-2 flex-shrink-0">@a.Priority</span>
                                    </div>
                                    <p class="card-text small text-muted">@a.Body</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
